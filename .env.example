# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Neon Database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible)
# Get these with `neonctl env pull` for the linked branch.
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.us-east-1.aws.neon.tech
S3_BUCKET=portlane-files

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# App
PUBLIC_APP_URL=http://localhost:3000

# Cron — bearer token for GET /api/cron/storage-sweep (Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`; see vercel.json)
CRON_SECRET=your-cron-secret

# Resend (transactional emails)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Portlane <onboarding@resend.dev>

# Sentry (error monitoring) — optional; leave the DSN blank to disable. The org,
# project and auth token are only needed at build time to upload source maps.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
