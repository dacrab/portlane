DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.us-east-1.aws.neon.tech
S3_BUCKET=portlane-files

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret

# Demo mode is on by default: sign-ups skip email verification, no email is
# sent, and client invites show a temporary password in the UI. Set to false
# when a verified sending domain is configured.
DEMO_MODE=true

RESEND_API_KEY=
EMAIL_FROM=

SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
