{
	"name": "portlane",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"dev": "doppler run -- vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"knip": "knip",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"auth": "^1.7.10",
		"drizzle-kit": "^0.31.10",
		"knip": "^6.26.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"@better-auth/core": "^1.6.23",
		"@internationalized/date": "^3.12.2",
		"@neondatabase/serverless": "^1.1.0",
		"@sentry/sveltekit": "^11.8.0",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"drizzle-orm": "^0.45.2",
		"phosphor-icons-svelte": "^2.1.0",
		"resend": "^6.26.0",
		"stripe": "^23.0.0",
		"svelte-sonner": "^1.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
